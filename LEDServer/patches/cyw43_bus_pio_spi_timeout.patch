+// Timeout wrapper for DMA channel wait (default 10ms)
+// Uses DMA CH[n].CTRL.BUSY bit (bit 24) since SDK v2.1.0 has no dma_channel_is_finished()
+static int dma_wait_timeout_ms(uint channel, uint timeout_ms) {
+    absolute_time_t end = make_timeout_time_ms(timeout_ms);
+    while (dma_hw->ch[channel].ctrl_trig & DMA_CH0_CTRL_TRIG_BUSY_BITS) {
+        if (time_reached(end)) {
+            return -5; // EIO
+        }
+        tight_loop_contents();
+    }
+    return 0;
+}
